page {
  background: #f2f4f7;
  color: #17211b;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

button {
  font-size: 28rpx;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 56rpx;
}

.page-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.eyebrow {
  color: #65736a;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.title {
  color: #102019;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  color: #65736a;
  font-size: 25rpx;
  line-height: 1.55;
  margin-top: 10rpx;
}

.surface {
  background: #ffffff;
  border: 1rpx solid #dde3df;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: 84rpx;
  border-radius: 12rpx;
  line-height: 84rpx;
  font-weight: 600;
}

.primary-button {
  background: #176b4a;
  color: #ffffff;
}

.secondary-button {
  background: #e7f1eb;
  color: #176b4a;
}

.danger-button {
  background: #fcecec;
  color: #a43232;
}

.ghost-button {
  background: transparent;
  color: #315c47;
  font-weight: 600;
  line-height: 72rpx;
  min-height: 72rpx;
  padding: 0 12rpx;
}

.text-button {
  display: inline;
  background: transparent;
  color: #176b4a;
  font-size: 27rpx;
  line-height: 1.4;
  padding: 0;
  margin: 0;
}

.code {
  font-family: "SFMono-Regular", Consolas, monospace;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}

.muted {
  color: #718078;
}

.error-banner {
  background: #fff1ee;
  border: 1rpx solid #efc8c0;
  color: #8d3527;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

