.settings-card,
.status-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.field-label {
  color: #5b6a61;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.field-input {
  background: #f4f6f5;
  border: 1rpx solid #dde3df;
  border-radius: 10rpx;
  box-sizing: border-box;
  height: 84rpx;
  padding: 0 22rpx;
  margin-bottom: 18rpx;
}

.settings-card button {
  margin-top: 14rpx;
}

.device-name {
  color: #17211b;
  font-size: 34rpx;
  font-weight: 650;
}

