<view class="page">
  <view class="page-header">
    <view>
      <view class="eyebrow">同步服务</view>
      <view class="title">连接设置</view>
      <view class="subtitle">开发环境可填写局域网地址，正式发布必须使用已备案的 HTTPS 域名。</view>
    </view>
  </view>

  <view wx:if="{{error}}" class="error-banner">{{error}}</view>

  <view class="surface settings-card">
    <view class="field-label">服务地址</view>
    <input
      class="field-input"
      value="{{serverUrl}}"
      placeholder="https://parcel.example.com"
      bindinput="onServerInput"
    />
    <button class="primary-button" bindtap="saveServer">保存地址</button>
    <button class="secondary-button" loading="{{testing}}" bindtap="testConnection">测试连接</button>
  </view>

  <view class="surface status-card">
    <view class="field-label">当前采集端</view>
    <view class="device-name">{{deviceName || '尚未连接'}}</view>
  </view>

  <button class="danger-button" bindtap="resetPairing">解除当前连接</button>
</view>

